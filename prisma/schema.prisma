generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id            String        @id
  name          String
  blurb         String?
  order         Int           @default(0)
  subcategories Subcategory[]
  products      Product[]
  extraProducts Product[]     @relation("ProductExtraCategories")
}

model Subcategory {
  id         String   @id @default(cuid())
  name       String
  order      Int      @default(0)
  iconUrl    String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
}

model Product {
  id              String         @id @default(cuid())
  name            String
  subtitle        String?
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  subcategoryId   String?
  subcategory     Subcategory?   @relation(fields: [subcategoryId], references: [id])
  extraCategories Category[]     @relation("ProductExtraCategories")
  price           Int
  wasPrice        Int?
  stock           Int            @default(0)
  description     String?
  features        String[]
  colors          String[]
  sizes           String[]
  outOfStockSizes String[]
  badge           String?
  gradientIndex   Int            @default(0)
  images          ProductImage[]
  rating          Float          @default(5)
  ratingCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Int     @default(0)
}

model Guide {
  id       String   @id @default(cuid())
  order    Int      @default(0)
  title    String
  teaser   String
  sections Json
  steps    String[]
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String
  phone        String
  email        String?
  city         String?
  address      String?
  notes        String?
  items        Json
  shipping     Int
  total        Int
  status       OrderStatus @default(NEW)
  createdAt    DateTime    @default(now())
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  SENT
}

model StoreSettings {
  id               String @id @default("singleton")
  storeName        String
  phone            String
  address          String
  tickerHtml       String
  shippingCost     Int
  freeShippingOver Int
}

model SiteText {
  key   String @id
  value String
}
